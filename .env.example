# Copy to .env and fill in from your Supabase project (Settings -> API).
# Never commit the filled-in .env — it is gitignored.

# Project URL only — https://<ref>.supabase.co with no path. The client appends
# /rest/v1 and /auth/v1 itself; leaving those on gives PGRST125 on every call.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Server-side only — keep out of the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# LEAVE THIS EMPTY unless your project still signs access tokens with the old
# shared HS256 secret. Most no longer do: Supabase issues ES256 tokens, verified
# against the project's public JWKS endpoint, which is derived from SUPABASE_URL
# and needs no secret at all. The startup log prints which mode is in use.
#
# Do not judge this from the anon key -- that is an HS256 JWT either way. Decode
# a real access token instead. See app/dependencies.py.
SUPABASE_JWT_SECRET=

# Local server settings. The Dockerfile overrides HOST=0.0.0.0 and RELOAD=0.
HOST=127.0.0.1
PORT=8000
RELOAD=1

