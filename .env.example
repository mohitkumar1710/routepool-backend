# Copy to .env and fill in from your Supabase project (Settings -> API).
# Never commit the filled-in .env — it is gitignored.

# Project URL only — https://<ref>.supabase.co with no path. The client appends
# /rest/v1 and /auth/v1 itself; leaving those on gives PGRST125 on every call.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Server-side only — keep out of the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Local server settings. The Dockerfile overrides HOST=0.0.0.0 and RELOAD=0.
HOST=127.0.0.1
PORT=8000
RELOAD=1

